<div class="page-header with-action">
  <div>
    <h2><%= ticket.subject %></h2>
    <p class="text-muted">
      <code><%= ticket.ticket_number %></code> ·
      <span class="badge badge-<%= ticket.status === 'open' ? 'success' : (ticket.status === 'pending' ? 'warn' : 'muted') %>"><%= ticket.status %></span>
      · Priority: <span class="badge badge-<%= ticket.priority === 'urgent' ? 'muted' : (ticket.priority === 'high' ? 'warn' : 'role') %>"><%= ticket.priority %></span>
    </p>
  </div>
  <a href="/tickets" class="btn">← All Tickets</a>
</div>

<div class="detail-grid">
  <div class="detail-card">
    <h3>Subscriber</h3>
    <% if (ticket.subscriber_id) { %>
      <table class="kv-table">
        <tr><td>Name</td><td><%= ticket.subscriber_name %></td></tr>
        <tr><td>Phone</td><td><%= ticket.subscriber_phone %></td></tr>
        <tr><td>Account</td><td><code><%= ticket.account_number %></code></td></tr>
      </table>
      <div style="margin-top:12px;">
        <a href="/subscribers/<%= ticket.subscriber_id %>" class="btn btn-sm">View Subscriber →</a>
      </div>
    <% } else { %>
      <p class="text-muted">No subscriber attached.</p>
      <% if (ticket.contact_name || ticket.contact_phone) { %>
        <table class="kv-table" style="margin-top:12px;">
          <% if (ticket.contact_name) { %><tr><td>Contact</td><td><%= ticket.contact_name %></td></tr><% } %>
          <% if (ticket.contact_phone) { %><tr><td>Phone</td><td><%= ticket.contact_phone %></td></tr><% } %>
        </table>
      <% } %>
    <% } %>
  </div>

  <div class="detail-card">
    <h3>Ticket Info</h3>
    <table class="kv-table">
      <tr><td>Category</td><td><%= ticket.category %></td></tr>
      <tr><td>Created</td><td><%= new Date(ticket.created_at).toLocaleString() %></td></tr>
      <tr><td>Updated</td><td><%= new Date(ticket.updated_at).toLocaleString() %></td></tr>
      <% if (ticket.resolved_at) { %>
        <tr><td>Resolved</td><td><%= new Date(ticket.resolved_at).toLocaleString() %></td></tr>
      <% } %>
    </table>

    <form method="POST" action="/tickets/<%= ticket.id %>/update" style="margin-top:16px;">
      <div class="form-row">
        <div class="form-group">
          <label>Status</label>
          <select name="status">
            <option value="open" <%= ticket.status === 'open' ? 'selected' : '' %>>Open</option>
            <option value="pending" <%= ticket.status === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="resolved" <%= ticket.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
            <option value="closed" <%= ticket.status === 'closed' ? 'selected' : '' %>>Closed</option>
          </select>
        </div>
        <div class="form-group">
          <label>Priority</label>
          <select name="priority">
            <option value="low" <%= ticket.priority === 'low' ? 'selected' : '' %>>Low</option>
            <option value="normal" <%= ticket.priority === 'normal' ? 'selected' : '' %>>Normal</option>
            <option value="high" <%= ticket.priority === 'high' ? 'selected' : '' %>>High</option>
            <option value="urgent" <%= ticket.priority === 'urgent' ? 'selected' : '' %>>Urgent</option>
          </select>
        </div>
      </div>
      <button type="submit" class="btn btn-primary btn-sm">Update</button>
    </form>
  </div>
</div>

<div class="detail-card">
  <h3>Conversation</h3>

  <% if (!messages.length) { %>
    <p class="text-muted">No messages yet.</p>
  <% } else { %>
    <div class="ticket-thread">
      <% messages.forEach(function(m) { %>
        <div class="ticket-msg ticket-msg-<%= m.sender_type %> <%= m.is_internal ? 'ticket-msg-internal' : '' %>">
          <div class="ticket-msg-header">
            <strong><%= m.sender_name || m.sender_type %></strong>
            <span class="badge badge-<%= m.sender_type === 'staff' ? 'role' : 'muted' %>"><%= m.sender_type %></span>
            <% if (m.is_internal) { %><span class="badge badge-warn">internal</span><% } %>
            <span class="text-muted" style="font-size:12px;margin-left:auto;"><%= new Date(m.created_at).toLocaleString() %></span>
          </div>
          <div class="ticket-msg-body"><%= m.body %></div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <form method="POST" action="/tickets/<%= ticket.id %>/reply" style="margin-top:20px;">
    <div class="form-group">
      <label for="body">Reply</label>
      <textarea id="body" name="body" rows="4" required placeholder="Type your reply..."></textarea>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="new_status">Set Status</label>
        <select id="new_status" name="new_status">
          <option value="">— Leave unchanged —</option>
          <option value="open">Open</option>
          <option value="pending">Pending</option>
          <option value="resolved">Resolved</option>
          <option value="closed">Closed</option>
        </select>
      </div>
      <div class="form-group" style="justify-content:flex-end;">
        <label class="checkbox-label">
          <input type="checkbox" name="is_internal" value="1">
          Internal note (not sent to subscriber)
        </label>
      </div>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Send Reply</button>
    </div>
  </form>
</div>
