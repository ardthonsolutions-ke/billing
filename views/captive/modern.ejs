<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="<%= tenant.primary_color %>">
  <title><%= tenant.name %> — Connect</title>
  <link rel="icon" href="<%= tenant.favicon_url || tenant.logo_url || '/icons/favicon-32.png' %>">
  <link rel="stylesheet" href="/css/captive.css">
  <style>
    :root {
      --c-brand: <%= tenant.primary_color || '#1a4a8a' %>;
      --c-accent: <%= tenant.accent_color || '#e85d2c' %>;
    }
    body { background: #0f0f1a; color: #fff; }
    .captive-shell { max-width: 640px; }
    .captive-welcome, .captive-plan, .captive-support, .captive-form-card {
      background: #1a1a2e;
      border-color: #2a2a44;
      color: #fff;
    }
    .captive-plan-name, .captive-support h3, .section-title { color: #fff; }
    .captive-plan-price { color: var(--c-accent); }
    .captive-plan-features li { color: #9090a8; }
    .captive-plan-features li::before { color: var(--c-accent); }
    .captive-support-btn { background: #0f0f1a; color: #fff; border-color: #2a2a44; }
    .captive-support-btn:hover { border-color: var(--c-accent); color: var(--c-accent); }
    .captive-footer { color: #9090a8; }
    .captive-footer a { color: var(--c-accent); }
    .captive-form-title, .captive-field label { color: #fff; }
    .captive-field input { background: #0f0f1a; color: #fff; border-color: #2a2a44; }
    .captive-form-sub { color: #9090a8; }
  </style>
</head>
<body class="tpl-modern font-<%= tenant.portal_font || 'system' %>">

<div class="captive-shell">

  <header class="captive-header">
    <div class="captive-logo">
      <% if (tenant.logo_url) { %>
        <img src="<%= tenant.logo_url %>" alt="<%= tenant.name %>">
      <% } else { %>
        <%= tenant.name.substring(0,2).toUpperCase() %>
      <% } %>
    </div>
    <h1 class="captive-name"><%= tenant.name %></h1>
    <% if (tenant.tagline) { %>
      <div class="captive-tagline"><%= tenant.tagline %></div>
    <% } %>
  </header>

  <% if (activeSubscriber) { %>
    <div class="captive-welcome">
      <div class="status-pill status-online" style="margin-bottom:10px;">✓ You're online</div>
      <p>Welcome back, <strong><%= activeSubscriber.full_name %></strong>!</p>
    </div>
    <a href="/captive/reconnect?tenant=<%= tenant.slug %>&mac=<%= mac %>" class="captive-btn captive-btn-accent">Reconnect Now</a>
  <% } else { %>

    <% if (tenant.advert_image_url) { %>
      <a href="<%= tenant.advert_link || '#' %>" class="captive-advert" target="_blank">
        <img src="<%= tenant.advert_image_url %>" alt="Advert">
      </a>
    <% } %>

    <div class="captive-welcome">
      <p><%= tenant.portal_welcome || '⚡ Get online in seconds. Choose your plan.' %></p>
    </div>

    <h2 class="section-title">⚡ Fast Plans</h2>
    <div class="captive-plans">
      <% plans.forEach(function(plan) { %>
        <a href="/captive/buy/<%= plan.id %>?tenant=<%= tenant.slug %>&mac=<%= mac %>&ip=<%= ip %>&router=<%= routerId %>" class="captive-plan">
          <div class="captive-plan-name"><%= plan.name %></div>
          <div class="captive-plan-price">
            KSh <%= Number(plan.price).toLocaleString() %>
            <small><%= plan.duration_hours ? '/' + plan.duration_hours + 'h' : '' %></small>
          </div>
          <ul class="captive-plan-features">
            <% if (plan.duration_hours) { %><li><%= plan.duration_hours %> hours</li><% } %>
            <% if (plan.data_cap_mb) { %>
              <li><%= plan.data_cap_mb >= 1024 ? Math.round(plan.data_cap_mb/1024) + ' GB' : plan.data_cap_mb + ' MB' %></li>
            <% } else { %><li>Unlimited data</li><% } %>
          </ul>
          <span class="captive-plan-cta">GET ONLINE →</span>
        </a>
      <% }); %>
    </div>

  <% } %>

  <div class="captive-support">
    <h3>💬 Need help?</h3>
    <div class="captive-support-actions">
      <% if (tenant.support_phone || tenant.contact_phone) { %>
        <a href="tel:<%= tenant.support_phone || tenant.contact_phone %>" class="captive-support-btn">📞 Call us</a>
      <% } %>
      <% if (tenant.support_whatsapp) { %>
        <a href="https://wa.me/<%= tenant.support_whatsapp.replace(/[^0-9]/g, '') %>" target="_blank" class="captive-support-btn">💬 WhatsApp</a>
      <% } %>
      <% if (tenant.support_email || tenant.contact_email) { %>
        <a href="mailto:<%= tenant.support_email || tenant.contact_email %>" class="captive-support-btn">✉ Email</a>
      <% } %>
    </div>
  </div>

  <footer class="captive-footer">
    <div>Powered by <a href="https://ardthonsolutions.com" target="_blank">Ardthon Billing</a></div>
  </footer>

</div>

</body>
</html>
