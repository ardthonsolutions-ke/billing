<div class="page-header with-action">
  <div>
    <h2><%= lead.full_name %></h2>
    <p class="text-muted">
      <%= lead.phone %> ·
      <span class="badge badge-<%= lead.status === 'converted' ? 'success' : (lead.status === 'lost' ? 'muted' : (lead.status === 'qualified' ? 'role' : 'warn')) %>"><%= lead.status %></span>
    </p>
  </div>
  <a href="/leads" class="btn">← All Leads</a>
</div>

<% if (lead.status !== 'converted' && lead.status !== 'lost') { %>
<div class="p-action-bar">
  <form method="POST" action="/leads/<%= lead.id %>/convert" class="inline-form" style="flex:1;">
    <button type="submit" class="btn btn-primary p-btn-lg" style="width:100%;">✓ Convert to Subscriber</button>
  </form>
</div>
<% } %>

<div class="detail-grid">
  <div class="detail-card">
    <h3>Contact</h3>
    <table class="kv-table">
      <tr><td>Phone</td><td><%= lead.phone %></td></tr>
      <tr><td>Email</td><td><%= lead.email || '—' %></td></tr>
      <tr><td>Location</td><td><%= lead.location || '—' %></td></tr>
      <tr><td>Source</td><td><%= lead.source %></td></tr>
    </table>
  </div>

  <div class="detail-card">
    <h3>Status</h3>
    <form method="POST" action="/leads/<%= lead.id %>">
      <div class="form-group">
        <label>Status</label>
        <select name="status">
          <option value="new" <%= lead.status === 'new' ? 'selected' : '' %>>New</option>
          <option value="contacted" <%= lead.status === 'contacted' ? 'selected' : '' %>>Contacted</option>
          <option value="qualified" <%= lead.status === 'qualified' ? 'selected' : '' %>>Qualified</option>
          <option value="converted" <%= lead.status === 'converted' ? 'selected' : '' %>>Converted</option>
          <option value="lost" <%= lead.status === 'lost' ? 'selected' : '' %>>Lost</option>
        </select>
      </div>
      <div class="form-group">
        <label>Priority</label>
        <select name="priority">
          <option value="low" <%= lead.priority === 'low' ? 'selected' : '' %>>Low</option>
          <option value="normal" <%= lead.priority === 'normal' ? 'selected' : '' %>>Normal</option>
          <option value="high" <%= lead.priority === 'high' ? 'selected' : '' %>>High</option>
        </select>
      </div>
      <div class="form-group">
        <label>Follow-up</label>
        <input type="datetime-local" name="follow_up_at" value="<%= lead.follow_up_at ? new Date(lead.follow_up_at).toISOString().slice(0,16) : '' %>">
      </div>
      <div class="form-group">
        <label>Notes</label>
        <textarea name="notes" rows="4"><%= lead.notes || '' %></textarea>
      </div>
      <button type="submit" class="btn btn-primary btn-sm">Update</button>
    </form>
  </div>
</div>

<div class="detail-card">
  <h3>Interest</h3>
  <p><%= lead.interest || 'No specific interest noted.' %></p>
</div>

<% if (events && events.length > 0) { %>
<div class="detail-card">
  <h3>Activity Log</h3>
  <table class="kv-table">
    <% events.forEach(function(e) { %>
      <tr>
        <td><%= e.event_type.replace('_', ' ') %></td>
        <td>
          <%= e.notes || '—' %>
          <div class="text-muted" style="font-size:12px;"><%= new Date(e.created_at).toLocaleString() %></div>
        </td>
      </tr>
    <% }); %>
  </table>
</div>
<% } %>
