<header class="abs-topbar">
  <button type="button" class="topbar-icon-btn" onclick="document.body.classList.toggle('nav-open')" aria-label="Menu" style="display:none" id="mobile-menu-btn">
    <svg viewBox="0 0 24 24"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
  </button>

  <%- include('../partials/breadcrumb') %>

  <button type="button" class="topbar-search" onclick="window.ABSCommand && window.ABSCommand.open()" aria-label="Search">
    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
    <span>Search anything...</span>
    <span class="kbd">⌘K</span>
  </button>

  <div class="topbar-actions">
    <% if (currentTenant) { %>
      <span class="tenant-badge"><%= currentTenant.name %></span>
    <% } else if (currentUser && currentUser.role === 'super_admin') { %>
      <span class="tenant-badge super">Super Admin</span>
    <% } %>

    <div class="theme-toggle-group" role="group" aria-label="Theme">
      <button type="button" class="theme-btn" data-mode="light" aria-label="Light">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button type="button" class="theme-btn" data-mode="dark" aria-label="Dark">
        <svg viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <button type="button" class="theme-btn" data-mode="system" aria-label="System">
        <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
      </button>
    </div>
  </div>
</header>

<style>
@media (max-width: 768px) {
  #mobile-menu-btn { display: inline-flex !important; }
}
</style>
