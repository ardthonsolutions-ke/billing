<%
var section = 'dashboard';
var sectionTitle = 'Overview';
if (currentPath.startsWith('/network')) { section = 'network'; sectionTitle = 'Network'; }
else if (currentPath.startsWith('/subscribers')) { section = 'subscribers'; sectionTitle = 'Customers'; }
else if (currentPath.startsWith('/plans')) { section = 'plans'; sectionTitle = 'Packages'; }
else if (currentPath.startsWith('/routers')) { section = 'routers'; sectionTitle = 'Devices'; }
else if (currentPath.startsWith('/payments')) { section = 'payments'; sectionTitle = 'Billing'; }
else if (currentPath.startsWith('/reports')) { section = 'reports'; sectionTitle = 'Insights'; }
else if (currentPath.startsWith('/tickets')) { section = 'tickets'; sectionTitle = 'Support'; }
else if (currentPath.startsWith('/leads')) { section = 'leads'; sectionTitle = 'Growth'; }
else if (currentPath.startsWith('/tenants')) { section = 'tenants'; sectionTitle = 'Platform'; }
else if (currentPath.startsWith('/users')) { section = 'users'; sectionTitle = 'Team'; }
else if (currentPath.startsWith('/settings')) { section = 'settings'; sectionTitle = 'Settings'; }
%>
<aside class="abs-sidebar">
  <div class="sidebar-head">
    <div class="sidebar-head-title">Ardthon Billing</div>
    <div class="sidebar-head-sub"><%= sectionTitle %></div>
  </div>

  <nav class="sidebar-nav">
    <% if (section === 'dashboard') { %>
      <a href="/dashboard" class="nav-link">Overview</a>
      <a href="/network" class="nav-link">Live network</a>
      <a href="/reports" class="nav-link">Reports</a>
    <% } else if (section === 'network') { %>
      <a href="/network" class="nav-link">Live overview</a>
      <a href="/network/active" class="nav-link">Active sessions</a>
      <a href="/network/history" class="nav-link">History</a>
      <a href="/routers" class="nav-link">Routers</a>
    <% } else if (section === 'subscribers') { %>
      <a href="/subscribers" class="nav-link">All subscribers</a>
      <a href="/subscribers/new" class="nav-link">Add subscriber</a>
    <% } else if (section === 'plans') { %>
      <a href="/plans" class="nav-link">All packages</a>
      <a href="/plans/new" class="nav-link">New package</a>
    <% } else if (section === 'routers') { %>
      <a href="/routers" class="nav-link">All routers</a>
      <a href="/routers/new" class="nav-link">Link router</a>
    <% } else if (section === 'payments') { %>
      <a href="/payments" class="nav-link">All payments</a>
      <a href="/reports/revenue" class="nav-link">Revenue</a>
    <% } else if (section === 'reports') { %>
      <a href="/reports" class="nav-link">Overview</a>
      <a href="/reports/revenue" class="nav-link">Revenue</a>
      <a href="/reports/subscribers" class="nav-link">Subscribers</a>
    <% } else if (section === 'tickets') { %>
      <a href="/tickets" class="nav-link">All tickets</a>
      <a href="/tickets/new" class="nav-link">New ticket</a>
    <% } else if (section === 'leads') { %>
      <a href="/leads" class="nav-link">All leads</a>
      <a href="/leads/new" class="nav-link">New lead</a>
    <% } else if (section === 'tenants') { %>
      <a href="/tenants" class="nav-link">All tenants</a>
      <a href="/tenants/new" class="nav-link">Add tenant</a>
      <a href="/users" class="nav-link">Users</a>
    <% } else if (section === 'users') { %>
      <a href="/users" class="nav-link">All users</a>
      <a href="/users/new" class="nav-link">Invite user</a>
    <% } else if (section === 'settings') { %>
      <a href="/settings" class="nav-link">General</a>
      <a href="/settings#payment" class="nav-link">Payments</a>
      <a href="/settings#sms" class="nav-link">Communications</a>
      <a href="/settings#password" class="nav-link">Password</a>
    <% } %>
  </nav>

  <div class="sidebar-foot">
    <div class="sidebar-user">
      <div class="user-avatar"><%= currentUser ? currentUser.full_name.substring(0,1).toUpperCase() : '?' %></div>
      <div class="user-info">
        <div class="user-name"><%= currentUser ? currentUser.full_name : 'Guest' %></div>
        <div class="user-role"><%= currentUser ? currentUser.role.replace('_',' ') : '' %></div>
      </div>
    </div>
  </div>
</aside>
