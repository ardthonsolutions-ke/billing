<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#c2542a" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0f0e0c" media="(prefers-color-scheme: dark)">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="color-scheme" content="light dark">

  <title><%= typeof title !== 'undefined' ? title + ' — ' + APP_NAME : APP_NAME %></title>

  <link rel="preconnect" href="https://fonts.bunny.net">
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/admin-180.png">

  <link rel="stylesheet" href="/css/dashboard.css?v=20261006a">
  <% if (currentPath && currentPath.startsWith('/reports')) { %>
    <link rel="stylesheet" href="/css/reports.css?v=20261006a">
  <% } %>
  <% if (currentPath && currentPath.startsWith('/network')) { %>
    <link rel="stylesheet" href="/css/network.css?v=20261006a">
  <% } %>

  <script src="/js/theme.js?v=20261006a"></script>
</head>
<body class="abs-app">
  <div class="app-shell">
    <%- include('../partials/rail') %>
    <%- include('../partials/sidebar', { currentPath: currentPath || '/dashboard' }) %>
    <div class="app-content">
      <%- include('../partials/topbar') %>
      <main class="app-main">
        <%- include('../partials/flash') %>
        <%- body %>
      </main>
    </div>
  </div>

  <!-- Mobile bottom nav -->
  <nav class="mobile-bottom-nav">
    <a href="/dashboard" class="mobile-nav-item <%= currentPath === '/dashboard' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1V9.5z"/></svg>
      <span>Home</span>
    </a>
    <a href="/network" class="mobile-nav-item <%= currentPath.startsWith('/network') ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
      <span class="rail-badge" data-health="unknown" aria-hidden="true"></span>
      <span>Network</span>
    </a>
    <a href="/subscribers" class="mobile-nav-item <%= currentPath.startsWith('/subscribers') ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
      <span>Subs</span>
    </a>
    <a href="/payments" class="mobile-nav-item <%= currentPath.startsWith('/payments') ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
      <span>Pay</span>
    </a>
    <a href="#" onclick="document.body.classList.toggle('nav-open');return false;" class="mobile-nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
      <span>More</span>
    </a>
  </nav>

  <%- include('../partials/pwa-install', { pwaLabel: 'ABS Admin', pwaIcon: '/icons/admin-192.png', pwaManifest: '/manifest.json' }) %>

  <script src="/js/command-palette.js?v=20261006a"></script>
  <script src="/js/rail.js?v=20261006b"></script>
  <script src="/js/rail-health.js?v=20261006a"></script>
  <script src="/js/mini-chart.js?v=20261006a"></script>
  <script src="/js/pwa.js?v=20261006a"></script>
  <% if (currentPath && currentPath.startsWith('/settings')) { %>
    <script src="/js/settings.js?v=20261006a"></script>
  <% } %>
  <% if (currentPath && currentPath.startsWith('/network')) { %>
    <script src="/js/network.js?v=20261006a"></script>
  <% } %>
</body>
</html>
