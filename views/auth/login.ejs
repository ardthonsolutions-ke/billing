<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-brand">
      <div class="auth-logo">ABS</div>
      <h1>Ardthon Billing</h1>
      <p class="auth-sub">Sign in to your account</p>
    </div>

    <%- include('../partials/flash') %>

    <form method="POST" action="/login" class="auth-form">
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autofocus autocomplete="email" placeholder="you@example.com">
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••">
      </div>
      <button type="submit" class="btn btn-primary btn-block">Sign In</button>
    </form>

    <p class="auth-footer">Ardthon Solutions &copy; <%= new Date().getFullYear() %></p>
  </div>
</div>
