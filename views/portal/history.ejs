<%- include('layout', { title: 'Payment History', tenant: tenant, subscriber: subscriber, flash: flash, active: 'history', body: '' }) %>

<div class="p-card">
  <h2>Payment History</h2>
  <p class="subtitle">All payment records for your account</p>

  <% if (!payments || payments.length === 0) { %>
    <p style="color:var(--p-muted);text-align:center;padding:40px 0;">No payments yet.</p>
    <div style="text-align:center;">
      <a href="/portal/plans" class="p-btn p-btn-primary">Browse Plans</a>
    </div>
  <% } else { %>
    <table class="p-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Plan</th>
          <th>Amount</th>
          <th>Method</th>
          <th>Status</th>
          <th>Reference</th>
        </tr>
      </thead>
      <tbody>
        <% payments.forEach(function(p) { %>
          <tr>
            <td><%= new Date(p.created_at).toLocaleString() %></td>
            <td><%= p.plan_name || '—' %></td>
            <td><strong>KSh <%= Number(p.amount).toLocaleString() %></strong></td>
            <td><%= p.method %></td>
            <td>
              <span class="p-badge p-badge-<%= p.status === 'completed' ? 'active' : (p.status === 'failed' ? 'expired' : 'pending') %>">
                <%= p.status %>
              </span>
            </td>
            <td style="font-size:11px;font-family:monospace;"><%= p.reference || '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>
