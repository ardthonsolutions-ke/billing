<%- include('layout', { title: 'Payment History', tenant: tenant, subscriber: subscriber, portalBase: portalBase, flash: flash, currentPath: portalBase + '/history', body: '' }) %>

<div class="p-card">
  <h2 style="margin:0 0 4px;">Payment history</h2>
  <p class="subtitle">All your past payments</p>
</div>

<% if (!payments || payments.length === 0) { %>
  <div class="p-empty">
    <div class="p-empty-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
    </div>
    <h3>No payments yet</h3>
    <p>When you buy a plan, your payments will appear here.</p>
    <a href="<%= portalBase %>/plans" class="p-btn p-btn-primary">Browse plans</a>
  </div>
<% } else { %>
  <%
  // Group by date
  var grouped = {};
  payments.forEach(function(p) {
    var d = new Date(p.created_at);
    var key = d.toLocaleDateString('en-KE', { day: 'numeric', month: 'short', year: 'numeric' });
    if (!grouped[key]) grouped[key] = [];
    grouped[key].push(p);
  });
  %>

  <% Object.keys(grouped).forEach(function(dateLabel) { %>
    <div class="p-history-day">
      <div class="p-history-day-label"><%= dateLabel %></div>
      <% grouped[dateLabel].forEach(function(p) { %>
        <div class="p-history-item">
          <div class="p-history-icon p-history-icon-<%= p.status === 'completed' ? 'success' : (p.status === 'pending' ? 'warn' : 'muted') %>">
            <% if (p.status === 'completed') { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            <% } else if (p.status === 'pending') { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            <% } else { %>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
            <% } %>
          </div>
          <div class="p-history-body">
            <div class="p-history-title">
              <%= p.plan_name || 'Payment' %>
            </div>
            <div class="p-history-sub">
              <%= new Date(p.created_at).toLocaleTimeString('en-KE', { hour: '2-digit', minute: '2-digit' }) %>
              · <%= p.method %>
              <% if (p.reference) { %>
                · <code><%= p.reference.slice(-12) %></code>
              <% } %>
            </div>
          </div>
          <div class="p-history-amount">
            <div class="p-history-price">KSh <%= Number(p.amount).toLocaleString() %></div>
            <span class="p-badge p-badge-<%= p.status === 'completed' ? 'active' : (p.status === 'pending' ? 'pending' : 'expired') %>"><%= p.status %></span>
          </div>
        </div>
      <% }); %>
    </div>
  <% }); %>
<% } %>
