<%- include('layout', { title: 'New Request', tenant: tenant, subscriber: subscriber, portalBase: portalBase, flash: flash, body: '' }) %>

<div class="p-card" style="max-width:600px;margin:0 auto;">
  <div style="margin-bottom:20px;">
    <h2 style="margin:0 0 4px;">New Support Request</h2>
    <p class="subtitle" style="margin:0;">Tell us what's wrong — we'll get back to you soon.</p>
  </div>

  <form method="POST" action="<%= portalBase %>/tickets/new">
    <div class="p-form-group">
      <label for="subject">Subject *</label>
      <input type="text" id="subject" name="subject" required placeholder="e.g. Internet not working since morning" maxlength="200">
    </div>

    <div class="p-form-group">
      <label for="category">Category</label>
      <select id="category" name="category">
        <option value="general">General</option>
        <option value="technical">Technical issue</option>
        <option value="billing">Billing / payment</option>
        <option value="installation">Installation</option>
        <option value="complaint">Complaint</option>
      </select>
    </div>

    <div class="p-form-group">
      <label for="message">Describe the issue</label>
      <textarea id="message" name="message" rows="6" placeholder="Explain what's happening..." style="width:100%;padding:11px 14px;border:1px solid var(--p-border);border-radius:8px;font-family:inherit;font-size:14px;resize:vertical;"></textarea>
    </div>

    <div style="display:flex;gap:10px;margin-top:20px;">
      <a href="<%= portalBase %>/tickets" class="p-btn" style="flex:1;text-align:center;justify-content:center;">Cancel</a>
      <button type="submit" class="p-btn p-btn-primary" style="flex:2;">Submit Request</button>
    </div>
  </form>

  <div style="margin-top:24px;padding:14px;background:var(--p-bg);border-radius:8px;font-size:12px;color:var(--p-muted);">
    <strong>Tip:</strong> Include when the issue started, any error messages, and your location to help us resolve faster.
  </div>
</div>
