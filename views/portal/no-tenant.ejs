<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal — No ISP</title>
  <link rel="stylesheet" href="/css/portal.css">
</head>
<body>
  <div class="portal-error-card">
    <h2>Portal not found</h2>
    <p>We couldn't determine your ISP. Please access this page via your ISP's subdomain, or contact your internet provider for the correct link.</p>
    <% if (slug) { %>
      <p style="margin-top:12px;font-size:12px;color:#991b1b;">
        Requested ISP: <strong><%= slug %></strong> — not found or inactive.
      </p>
    <% } %>
  </div>
</body>
</html>
