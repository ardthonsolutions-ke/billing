<%- include('layout', { title: 'Confirm Purchase', tenant: tenant, subscriber: subscriber, portalBase: portalBase, flash: flash, currentPath: portalBase + '/plans', body: '' }) %>

<a href="<%= portalBase %>/plans" class="p-back-link">← Back to plans</a>

<div class="p-card">
  <h2 style="margin:0 0 4px;">Confirm purchase</h2>
  <p class="subtitle">Review your plan and confirm</p>

  <div class="p-purchase-summary">
    <div class="p-purchase-row">
      <span>Plan</span>
      <strong><%= plan.name %></strong>
    </div>
    <% if (plan.duration_hours) { %>
      <div class="p-purchase-row">
        <span>Duration</span>
        <strong><%= plan.duration_hours %> hours</strong>
      </div>
    <% } %>
    <% if (plan.data_cap_mb) { %>
      <div class="p-purchase-row">
        <span>Data</span>
        <strong><%= plan.data_cap_mb >= 1024 ? Math.round(plan.data_cap_mb / 1024 * 10) / 10 + ' GB' : plan.data_cap_mb + ' MB' %></strong>
      </div>
    <% } %>
    <div class="p-purchase-row p-purchase-total">
      <span>Amount to pay</span>
      <strong>KSh <%= Number(plan.price).toLocaleString() %></strong>
    </div>
  </div>
</div>

<div class="p-card">
  <h3>How would you like to pay?</h3>

  <form method="POST" action="<%= portalBase %>/buy/<%= plan.id %>">
    <div class="p-form-group">
      <label for="phone">Your M-PESA phone number</label>
      <input type="tel" id="phone" name="phone" value="<%= subscriber.phone || '' %>" required placeholder="0712 345 678" pattern="[0-9+ ]{9,15}" autocomplete="tel">
      <div class="hint">We'll send the payment request to this number</div>
    </div>

    <button type="submit" class="p-btn p-btn-primary p-btn-block">
      Pay KSh <%= Number(plan.price).toLocaleString() %> with M-PESA
    </button>
  </form>

  <div class="p-alert p-alert-info" style="margin-top:16px;">
    <strong>What happens next?</strong><br>
    We'll create a payment request. Complete payment at the ISP office or wait for the M-PESA prompt (when enabled). Your account activates as soon as payment is confirmed.
  </div>
</div>
