<div class="page-header with-action">
  <div>
    <h2><%= subscriber.full_name %></h2>
    <p class="text-muted"><code><%= subscriber.account_number %></code> · <%= subscriber.phone %></p>
  </div>
  <div style="display:flex;gap:8px;">
    <a href="/subscribers/<%= subscriber.id %>/edit" class="btn">Edit</a>
    <% if (subscriber.status === 'active') { %>
      <form method="POST" action="/subscribers/<%= subscriber.id %>/suspend" class="inline-form">
        <button type="submit" class="btn">Suspend</button>
      </form>
    <% } else { %>
      <form method="POST" action="/subscribers/<%= subscriber.id %>/activate" class="inline-form">
        <button type="submit" class="btn btn-primary">Activate</button>
      </form>
    <% } %>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-label">Status</div>
    <div class="stat-value" style="font-size:20px;text-transform:capitalize;"><%= subscriber.status %></div>
    <div class="stat-hint">
      <% if (subscriber.expires_at) { %>
        Expires: <%= new Date(subscriber.expires_at).toLocaleString() %>
      <% } else { %>No expiry set<% } %>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Plan</div>
    <div class="stat-value" style="font-size:18px;"><%= subscriber.plan_name || 'None' %></div>
    <div class="stat-hint"><%= subscriber.plan_price ? 'KSh ' + Number(subscriber.plan_price).toLocaleString() : '' %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Type</div>
    <div class="stat-value" style="font-size:18px;text-transform:capitalize;"><%= subscriber.type %></div>
    <div class="stat-hint">Router: <%= subscriber.router_name || 'None' %></div>
  </div>
</div>

<div class="detail-grid">
  <div class="detail-card">
    <h3>Credentials</h3>
    <table class="kv-table">
      <tr><td>Username</td><td><code><%= subscriber.username %></code></td></tr>
      <tr><td>Password</td><td><code><%= subscriber.password_plain || '—' %></code></td></tr>
      <tr><td>MAC Address</td><td><%= subscriber.mac_address || '—' %></td></tr>
      <tr><td>IP Address</td><td><%= subscriber.ip_address || '—' %></td></tr>
    </table>
  </div>

  <div class="detail-card">
    <h3>Contact</h3>
    <table class="kv-table">
      <tr><td>Phone</td><td><%= subscriber.phone %></td></tr>
      <tr><td>Email</td><td><%= subscriber.email || '—' %></td></tr>
      <tr><td>Created</td><td><%= new Date(subscriber.created_at).toLocaleString() %></td></tr>
      <tr><td>Activated</td><td><%= subscriber.activated_at ? new Date(subscriber.activated_at).toLocaleString() : '—' %></td></tr>
    </table>
  </div>
</div>


<% if (typeof timeline !== 'undefined' && timeline.length > 0) { %>
<div class="detail-card">
  <h3>Activity Timeline</h3>
  <ul class="activity-timeline">
    <% timeline.forEach(function(item) { %>
      <li class="activity-item activity-<%= item.kind %>">
        <div class="activity-icon">
          <% if (item.kind === 'payment') { %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
          <% } else if (item.kind === 'ticket') { %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M2 9a3 3 0 0 1 3-3h14a3 3 0 0 1 3 3v1a2 2 0 0 0 0 4v1a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3v-1a2 2 0 0 0 0-4V9z"/></svg>
          <% } else { %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          <% } %>
        </div>
        <div class="activity-body">
          <div class="activity-title">
            <% if (item.link) { %><a href="<%= item.link %>"><%= item.title %></a><% } else { %><%= item.title %><% } %>
          </div>
          <% if (item.body) { %><div class="activity-meta text-muted"><%= item.body %></div><% } %>
          <div class="activity-time text-muted"><%= new Date(item.ts).toLocaleString('en-KE', { dateStyle: 'medium', timeStyle: 'short' }) %></div>
        </div>
      </li>
    <% }); %>
  </ul>
</div>
<% } %>
