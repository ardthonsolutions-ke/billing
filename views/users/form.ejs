<div class="page-header">
  <h2><%= targetUser ? 'Edit User: ' + targetUser.full_name : 'New User' %></h2>
  <p class="text-muted"><%= targetUser ? 'Update user details and permissions' : 'Add a new user' %></p>
</div>

<form method="POST" action="<%= targetUser ? '/users/' + targetUser.id : '/users' %>" class="form-card">
  <div class="form-row">
    <div class="form-group">
      <label for="full_name">Full Name *</label>
      <input type="text" id="full_name" name="full_name" required value="<%= targetUser ? targetUser.full_name : '' %>" placeholder="e.g. Jane Wanjiru">
    </div>
    <div class="form-group">
      <label for="email">Email *</label>
      <input type="email" id="email" name="email" required value="<%= targetUser ? targetUser.email : '' %>" <%= targetUser ? 'readonly' : '' %> placeholder="jane@example.com">
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label for="password">Password <%= targetUser ? '(leave blank to keep current)' : '*' %></label>
      <input type="password" id="password" name="password" <%= targetUser ? '' : 'required' %> minlength="6" placeholder="At least 6 characters">
    </div>
    <div class="form-group">
      <label for="role">Role *</label>
      <select id="role" name="role" required>
        <% if (currentUser.role === 'super_admin') { %>
          <option value="super_admin" <%= targetUser && targetUser.role === 'super_admin' ? 'selected' : '' %>>Super Admin</option>
        <% } %>
        <option value="isp_admin" <%= targetUser && targetUser.role === 'isp_admin' ? 'selected' : '' %>>ISP Admin</option>
        <option value="reseller" <%= targetUser && targetUser.role === 'reseller' ? 'selected' : '' %>>Reseller</option>
        <option value="staff" <%= targetUser && targetUser.role === 'staff' ? 'selected' : '' %>>Staff</option>
        <option value="accountant" <%= targetUser && targetUser.role === 'accountant' ? 'selected' : '' %>>Accountant</option>
      </select>
    </div>
  </div>

  <% if (currentUser.role === 'super_admin') { %>
    <div class="form-group">
      <label for="tenant_id">Tenant</label>
      <select id="tenant_id" name="tenant_id">
        <option value="">— None (platform-level) —</option>
        <% tenants.forEach(function(t) { %>
          <option value="<%= t.id %>" <%= targetUser && targetUser.tenant_id == t.id ? 'selected' : '' %>><%= t.name %></option>
        <% }); %>
      </select>
    </div>
  <% } %>

  <% if (targetUser) { %>
  <div class="form-group">
    <label class="checkbox-label">
      <input type="checkbox" name="is_active" value="1" <%= targetUser.is_active ? 'checked' : '' %>>
      Active (user can log in)
    </label>
  </div>
  <% } %>

  <div class="form-actions">
    <a href="/users" class="btn">Cancel</a>
    <button type="submit" class="btn btn-primary"><%= targetUser ? 'Save Changes' : 'Create User' %></button>
  </div>
</form>
