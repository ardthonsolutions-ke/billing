ALTER TABLE tenants ADD COLUMN IF NOT EXISTS support_email VARCHAR(150) DEFAULT NULL;
ALTER TABLE tenants ADD COLUMN IF NOT EXISTS support_whatsapp VARCHAR(30) DEFAULT NULL;
ALTER TABLE tenants ADD COLUMN IF NOT EXISTS portal_template VARCHAR(30) DEFAULT 'classic';
ALTER TABLE tenants ADD COLUMN IF NOT EXISTS portal_font VARCHAR(50) DEFAULT 'system';
ALTER TABLE tenants ADD COLUMN IF NOT EXISTS portal_welcome VARCHAR(300) DEFAULT NULL;
ALTER TABLE tenants ADD COLUMN IF NOT EXISTS portal_terms TEXT DEFAULT NULL;
ALTER TABLE tenants ADD COLUMN IF NOT EXISTS advert_image_url VARCHAR(500) DEFAULT NULL;
ALTER TABLE tenants ADD COLUMN IF NOT EXISTS advert_link VARCHAR(500) DEFAULT NULL;
ALTER TABLE tenants ADD COLUMN IF NOT EXISTS sms_gateway ENUM('none','africastalking','safaricom','twilio') DEFAULT 'none';
ALTER TABLE tenants ADD COLUMN IF NOT EXISTS sms_api_key VARCHAR(255) DEFAULT NULL;
ALTER TABLE tenants ADD COLUMN IF NOT EXISTS sms_username VARCHAR(100) DEFAULT NULL;
ALTER TABLE tenants ADD COLUMN IF NOT EXISTS payment_gateway ENUM('none','paybill','till') DEFAULT 'none';
ALTER TABLE tenants ADD COLUMN IF NOT EXISTS payment_shortcode VARCHAR(20) DEFAULT NULL;

-- Captive portal sessions
CREATE TABLE IF NOT EXISTS portal_sessions (
  id BIGINT AUTO_INCREMENT PRIMARY KEY,
  tenant_id INT NOT NULL,
  visitor_mac VARCHAR(20) DEFAULT NULL,
  visitor_ip VARCHAR(45) DEFAULT NULL,
  router_id INT DEFAULT NULL,
  phone VARCHAR(30) DEFAULT NULL,
  stage ENUM('visited','selected_plan','paid','active') DEFAULT 'visited',
  plan_id INT DEFAULT NULL,
  payment_id INT DEFAULT NULL,
  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  INDEX idx_tenant (tenant_id),
  INDEX idx_mac (visitor_mac),
  INDEX idx_created (created_at),
  FOREIGN KEY (tenant_id) REFERENCES tenants(id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
